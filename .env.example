# Application Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rekber_db?schema=public"

# Redis Connection (BullMQ, Rate Limiter & Concurrency Lock)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & OTP
OTP_SECRET_SALT=rekber_super_secure_otp_salt_2026
OTP_TTL_SECONDS=180
RATE_LIMIT_WINDOW_SECONDS=3600

# Payment Gateway (Midtrans / Xendit / Tripay)
PAYMENT_GATEWAY_PROVIDER=midtrans
PAYMENT_SERVER_KEY=SB-Mid-server-XXXXXX
PAYMENT_CLIENT_KEY=SB-Mid-client-XXXXXX
PAYMENT_WEBHOOK_SECRET=your_webhook_signature_secret_here

# Payout / Disbursement
DISBURSEMENT_API_KEY=xnd_development_XXXXXX
DISBURSEMENT_API_URL=https://api.xendit.co/disbursements

# WhatsApp Bot Configuration
WA_SESSION_AUTH_FOLDER=./auth_info_baileys
WA_ADMIN_PHONE_ALERT=6281234567890
ESCROW_FEE_PERCENTAGE=1.5
ESCROW_MIN_FEE_IDR=5000
